// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("USER")
  phone     String?  // WhatsApp do cliente
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders            Order[]
  pushSubscriptions PushSubscription[]
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductOrigin {
  MERCADO_LIVRE
  LOCAL
}

enum DescriptionSource {
  CUSTOM
  ML
}

enum PackageSize {
  SMALL   // Pequeno (Moto - mochila/bag: cordas, palhetas, afinadores, cabos, pedais)
  MEDIUM  // Médio (Moto com baú ou Carro)
  LARGE   // Grande (Carro - porta-malas: violões, guitarras, teclados, amplificadores)
  XLARGE  // Muito Grande (Carro/Utilitário - baterias, caixas grandes)
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  DISPATCHED
  DELIVERED
  CANCELLED
}

model Product {
  id                 String             @id @default(cuid())
  code               String?            @unique // Código fiscal interno da loja / SKU
  title              String
  price              Float
  originalPrice      Float?             // Preço original / anterior para ofertas e descontos
  currency_id        String             @default("BRL")
  thumbnail          String
  condition          String             @default("new")
  available_quantity Int                @default(0)
  seller_nickname    String             @default("Pink Music")
  permalink          String?            @unique
  origin             ProductOrigin      @default(MERCADO_LIVRE)
  isLocalSale        Boolean            @default(false)
  description        String?
  descriptionSource  DescriptionSource? @default(CUSTOM)
  isLocalPickup      Boolean            @default(true)
  packageSize        PackageSize        @default(SMALL)
  pictures           Picture[]
  orders             Order[]

  // NOVO: Relação com Marca
  brand   Brand?  @relation(fields: [brandId], references: [id])
  brandId String?

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?

  // NOVO: Campos para relevância
  views    Int     @default(0)
  sales    Int     @default(0)
  rating   Float?  @default(0)
  featured Boolean @default(false)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOVO: Índices para otimizar consultas
  @@index([origin])
  @@index([brandId])
  @@index([categoryId])
  @@index([views])
  @@index([sales])
  @@index([featured])
  @@index([active])
  @@index([code])
}

model Order {
  id              String      @id @default(cuid())
  customerName    String
  customerPhone   String

  // Produto único legado (mantido opcional para compatibilidade)
  productId       String?
  product         Product?    @relation(fields: [productId], references: [id])
  quantity        Int         @default(1)

  // Itens do carrinho (novo fluxo)
  items           OrderItem[]

  // Cliente autenticado (opcional)
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])

  totalAmount     Float
  discountAmount   Float       @default(0) // Desconto PIX aplicado (ex: 5%)
  deliveryType    String      // "pickup" | "delivery"
  deliveryAddress String?
  deliveryFee     Float       @default(0)
  status          OrderStatus @default(PENDING_PAYMENT)

  // Mercado Pago
  mpPaymentId    String?   @unique
  mpQrCode       String?
  mpQrCodeBase64 String?
  paidAt         DateTime?

  // Uber Direct (legado mantido para histórico)
  uberDeliveryId   String?
  uberTrackingUrl  String?
  uberDispatchedAt DateTime?
  uberCourierName  String?
  uberCourierPhone String?
  uberVehicleType  String? // "motorcycle", "car", "bicycle", etc.

  // Snapshot do Frete Local Próprio
  shippingPrice    Float?
  shippingCep      String?
  shippingZone     String?
  shippingDistance Float?
  shippingMethod   String? // "LOCAL_DELIVERY" | "PICKUP"
  needsReview      Boolean @default(false)

  // Corrida / Frete com Motoboy
  deliveryRide     DeliveryRide?

  // Controle de Notificação Push (idempotência)
  pushNotifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([mpPaymentId])
  @@index([productId])
  @@index([userId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  title       String
  price       Float
  quantity    Int     @default(1)
  thumbnail   String?
  productCode String? // Código fiscal do produto na época do pedido

  @@index([orderId])
  @@index([productId])
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// NOVO: Model para Marcas
model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logo      String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id            String     @id @default(cuid())
  name          String     @unique
  slug          String?    @unique
  parentId      String?
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories Category[] @relation("CategoryHierarchy")
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([parentId])
}

model Picture {
  id        String  @id @default(cuid())
  url       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

// Modelos para Sistema Próprio de Entrega Local por Zona e Distância
model ShippingZone {
  id          String   @id @default(cuid())
  name        String
  description String?
  order       Int      @unique // 1=Z1, 2=Z2, 3=Z3, 4=Z4 — substituí índice implícito por ordem explícita
  minDistance Float
  maxDistance Float
  price       Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zipCodes      ShippingZipCode[]
  neighborhoods ShippingNeighborhood[]

  @@index([active])
  @@index([order])
}

model ShippingZipCode {
  id         String        @id @default(cuid())
  zipCode    String        @unique // 8 dígitos normalizados (ex: "44002000")
  district   String        // Bairro
  city       String        @default("Feira de Santana")
  state      String        @default("BA")
  latitude   Float?
  longitude  Float?
  zoneId     String?
  zone       ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  // Rastreabilidade: como/de onde veio esse mapeamento
  source     String?       // "local_json" | "viacep" | "brasilapi" | "prefix" | "neighborhood_seed" | "manual"
  confidence String?       @default("high") // "high" | "medium" | "low"
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([zipCode])
  @@index([zoneId])
  @@index([confidence])
}

/**
 * Mapeamento canônico de bairros de Feira de Santana → Zona de entrega.
 * Alimentado pelo seed (53 bairros classificados pelo relatório v2).
 * Usado pelo resolveZone na Camada de Bairro antes de consultar APIs externas.
 */
model ShippingNeighborhood {
  id           String        @id @default(cuid())
  name         String        // Nome canônico (ex: "Centro")
  normalizedKey String       @unique // normalizeKey(name) — sem acento, lowercase, sem espaço
  aliases      String[]      // Variações alternativas normalizadas
  zoneId       String?       // null quando outOfArea = true
  zone         ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  outOfArea    Boolean       @default(false) // true = distrito rural confirmado (bloqueia entrega)
  zoneOrder    Int?          // 1–4, null quando outOfArea = true
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([normalizedKey])
  @@index([zoneId])
  @@index([outOfArea])
}

/**
 * Overrides manuais de CEP específico → Zona.
 * Usado na Camada 1 (prioridade máxima, antes de qualquer lookup).
 * Ex: 44068030 → Conjunto Fraternidade → Z3
 */
model ShippingZipOverride {
  id        String   @id @default(cuid())
  zipCode   String   @unique // 8 dígitos normalizados
  district  String   // Bairro do override
  zoneOrder Int      // 1–4
  note      String?  // Motivo do override manual
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zipCode])
}

/**
 * CEPs que chegaram ao sistema mas não puderam ser resolvidos deterministicamente.
 * Registra para revisão manual pelo administrador.
 */
model ShippingUnresolvedZip {
  id        String   @id @default(cuid())
  zipCode   String   @unique // 8 dígitos normalizados
  district  String?  // Bairro retornado pela API (pode estar vazio)
  city      String?
  state     String?
  reason    String   // "NO_NEIGHBORHOOD_MATCH" | "AMBIGUOUS" | "API_EMPTY"
  hitCount  Int      @default(1) // quantas vezes esse CEP foi consultado sem resolução
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zipCode])
  @@index([reason])
}

// Notificações Push para Administradores e Vendedores
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique @db.Text
  deviceName String?
  userAgent  String?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// Status da Corrida com Motoboy
enum DeliveryRideStatus {
  ASSIGNED    // Atribuída / Aguardando coleta
  IN_TRANSIT  // A caminho do cliente
  DELIVERED   // Entregue com sucesso
  CANCELLED   // Cancelada
}

// Status do Pagamento ao Motoboy
enum RidePaymentStatus {
  PENDING // A pagar
  PAID    // Pago / Liquidado
}

// Cadastro de Profissionais / Motoboys
model Courier {
  id          String   @id @default(cuid())
  name        String
  phone       String   // WhatsApp para contato e envio do espelho
  pixKey      String?  // Chave Pix (CPF, Telefone, E-mail, Aleatória)
  pixKeyType  String?  // "CPF" | "PHONE" | "EMAIL" | "RANDOM"
  vehicle     String?  // Ex: Honda CG 160 Fan
  plate       String?  // Placa da moto
  active      Boolean  @default(true)
  notes       String?  // Observações gerais
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rides       DeliveryRide[]

  @@index([active])
}

// Registro individual de cada Corrida / Frete
model DeliveryRide {
  id              String             @id @default(cuid())
  orderId         String             @unique
  order           Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  courierId       String
  courier         Courier            @relation(fields: [courierId], references: [id], onDelete: Restrict)

  // Valores financeiros
  clientFee       Float              // Valor que o cliente pagou de frete (Order.shippingPrice)
  courierFee      Float              // Valor a ser pago ao motoboy pela corrida
  distanceKm      Float?             // Distância da rota (km)

  // Controle de Status e Pagamento
  status          DeliveryRideStatus @default(ASSIGNED)
  paymentStatus   RidePaymentStatus  @default(PENDING)
  paidAt          DateTime?          // Data em que a loja pagou o motoboy
  paymentBatchId  String?            // Identificador de lote de fechamento

  assignedAt      DateTime           @default(now())
  deliveredAt     DateTime?
  notes           String?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([courierId])
  @@index([paymentStatus])
  @@index([status])
  @@index([assignedAt])
}
