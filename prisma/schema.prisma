// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductOrigin {
  MERCADO_LIVRE
  LOCAL
}

enum DescriptionSource {
  CUSTOM
  ML
}

enum PackageSize {
  SMALL   // Pequeno (Moto - mochila/bag: cordas, palhetas, afinadores, cabos, pedais)
  MEDIUM  // Médio (Moto com baú ou Carro)
  LARGE   // Grande (Carro - porta-malas: violões, guitarras, teclados, amplificadores)
  XLARGE  // Muito Grande (Carro/Utilitário - baterias, caixas grandes)
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  DISPATCHED
  DELIVERED
  CANCELLED
}

model Product {
  id                 String             @id @default(cuid())
  code               String?            @unique // Código fiscal interno da loja / SKU
  title              String
  price              Float
  currency_id        String             @default("BRL")
  thumbnail          String
  condition          String             @default("new")
  available_quantity Int                @default(0)
  seller_nickname    String             @default("Pink Music")
  permalink          String?            @unique
  origin             ProductOrigin      @default(MERCADO_LIVRE)
  description        String?
  descriptionSource  DescriptionSource? @default(CUSTOM)
  isLocalPickup      Boolean            @default(true)
  packageSize        PackageSize        @default(SMALL)
  pictures           Picture[]
  orders             Order[]

  // NOVO: Relação com Marca
  brand   Brand?  @relation(fields: [brandId], references: [id])
  brandId String?

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?

  // NOVO: Campos para relevância
  views    Int     @default(0)
  sales    Int     @default(0)
  rating   Float?  @default(0)
  featured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOVO: Índices para otimizar consultas
  @@index([origin])
  @@index([brandId])
  @@index([categoryId])
  @@index([views])
  @@index([sales])
  @@index([featured])
  @@index([code])
}

model Order {
  id              String      @id @default(cuid())
  customerName    String
  customerPhone   String
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  quantity        Int         @default(1)
  totalAmount     Float
  deliveryType    String      // "pickup" | "delivery"
  deliveryAddress String?
  deliveryFee     Float       @default(0)
  status          OrderStatus @default(PENDING_PAYMENT)

  // Mercado Pago
  mpPaymentId    String?   @unique
  mpQrCode       String?
  mpQrCodeBase64 String?
  paidAt         DateTime?

  // Uber Direct
  uberDeliveryId   String?
  uberTrackingUrl  String?
  uberDispatchedAt DateTime?
  uberCourierName  String?
  uberCourierPhone String?
  uberVehicleType  String? // "motorcycle", "car", "bicycle", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([mpPaymentId])
  @@index([productId])
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// NOVO: Model para Marcas
model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logo      String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id            String     @id @default(cuid())
  name          String     @unique
  slug          String?    @unique
  parentId      String?
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories Category[] @relation("CategoryHierarchy")
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([parentId])
}

model Picture {
  id        String  @id @default(cuid())
  url       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}
